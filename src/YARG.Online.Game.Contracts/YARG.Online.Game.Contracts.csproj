<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>YARG.Online.Game.Contracts</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Unity also consumes this directory as a UPM package; redirect build
         outputs to ~-suffixed folders so Unity hides them and doesn't try to
         compile the auto-generated .cs (GlobalUsings, AssemblyInfo, etc.). -->
    <BaseIntermediateOutputPath>obj~\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin~\</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.*" />
  </ItemGroup>

</Project>
