# Whitelist build context. Docker builds use `.` as context and the Dockerfiles
# do `COPY . .`, so ANY file present here busts the publish layer's cache and
# forces a rebuild. Exclude everything, then re-include only what
# `dotnet restore` / `dotnet publish` actually need.
*

# .NET build inputs
!global.json
!src/

# Re-exclude build output / IDE noise inside src/
**/bin/
**/obj/
**/bin~/
**/obj~/
**/.vs/

# Not needed to build the images
src/**/charts/
src/**/Dockerfile
src/YARG.Online.Game.Contracts - Copy/

# Test projects: not needed to build the production images.
src/**/*Tests/
